{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "deepseek-harness-tui",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "dshsuite.dev",
			"custom_domain": true
		}
	],
	"compatibility_date": "2026-08-18",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}