---
import "../styles/global.css";

const title = "Martty — 终端里的 Agent TUI";
const description =
  "Martty 是一个 DSH-first 的 Agent TUI:在终端中流式呈现推理、工具调用、subagent、多图 prompt 与持久化会话,界面由 Cordis 插件组合。";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#05070a" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Martty" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/social-preview.png", Astro.site ?? Astro.url.origin)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#05070a] text-[#e7eaee] antialiased">
    <div class="mx-auto flex min-h-screen max-w-5xl flex-col px-5 sm:px-8">
      <!-- Header -->
      <header class="flex items-center justify-between gap-4 border-b border-[#171d25] py-5">
        <a href="/" class="flex items-center gap-3 no-underline">
          <img src="/martty-lockup.svg" alt="Martty" class="h-9 w-auto" />
        </a>
        <nav class="flex items-center gap-4 text-sm text-[#9aa5b1]">
          <a href="#install" class="hover:text-[#e7eaee]">安装</a>
          <a href="#ui" class="hover:text-[#e7eaee]">UI 简介</a>
          <a href="#usage" class="hover:text-[#e7eaee]">使用方法</a>
          <a href="/en" class="rounded border border-[#202832] px-2 py-1 text-xs text-[#3aa0ff] hover:border-[#3aa0ff]">English</a>
        </nav>
      </header>

      <main class="flex-1">
        <!-- Hero -->
        <section class="border-b border-[#171d25] py-16 sm:py-20">
          <p class="mb-3 text-xs uppercase tracking-[0.2em] text-[#66707c]">
            DSH-first · Terminal-native · Cordis 插件
          </p>
          <h1 class="max-w-2xl text-4xl font-semibold leading-tight sm:text-5xl">
            在终端里,<span class="text-[#3aa0ff]">完整地看见</span>你的 Agent 在做什么。
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-[#9aa5b1]">
            Martty 是一个高性能的 Agent TUI(Rust / ratatui 渲染),流式呈现推理、工具调用、
            subagent、token 用量和持久化会话;图片可从文件或剪贴板加入 prompt。界面、主题、
            命令与视图都由 Cordis 插件组合,而不是写死在 shell 里。
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#install" class="rounded border border-[#1f4a73] bg-[rgba(58,160,255,0.12)] px-5 py-2.5 text-sm no-underline hover:border-[#3aa0ff]">安装 Martty</a>
            <a href="#ui" class="rounded border border-[#202832] px-5 py-2.5 text-sm no-underline hover:border-[#66707c]">看看界面</a>
            <a href="https://www.npmjs.com/package/martty" class="rounded border border-[#202832] px-5 py-2.5 text-sm no-underline hover:border-[#66707c]">npm</a>
            <a href="https://github.com/openma-ai/Martty" class="rounded border border-[#202832] px-5 py-2.5 text-sm no-underline hover:border-[#66707c]">GitHub</a>
          </div>
        </section>

        <!-- Install -->
        <section id="install" class="border-b border-[#171d25] py-14">
          <h2 class="mb-2 text-2xl font-semibold">如何安装</h2>
          <p class="mb-6 text-sm text-[#66707c]">需要 Node.js 18+。安装后直接启动,默认连接 DSH。</p>

          <h3 class="mb-2 text-sm font-semibold text-[#9aa5b1]">全局安装(推荐)</h3>
          <pre class="mb-6 overflow-x-auto rounded border border-[#202832] bg-[#0a0e13] p-4 text-sm text-[#e7eaee]"><code><span class="text-[#3aa0ff]">$ </span>npm install --global martty
<span class="text-[#3aa0ff]">$ </span>martty</code></pre>

          <h3 class="mb-2 text-sm font-semibold text-[#9aa5b1]">不想全局安装</h3>
          <pre class="mb-6 overflow-x-auto rounded border border-[#202832] bg-[#0a0e13] p-4 text-sm text-[#e7eaee]"><code><span class="text-[#3aa0ff]">$ </span>npx --yes martty</code></pre>

          <h3 class="mb-2 text-sm font-semibold text-[#9aa5b1]">已有 DSH:装到独立 profile,交给 DSH 管理</h3>
          <pre class="mb-6 overflow-x-auto rounded border border-[#202832] bg-[#0a0e13] p-4 text-sm text-[#e7eaee]"><code><span class="text-[#3aa0ff]">$ </span>npm install --global @deepseek-ai/dsh
<span class="text-[#3aa0ff]">$ </span>dsh plugin --profile martty add martty@latest
<span class="text-[#3aa0ff]">$ </span>dsh --profile martty</code></pre>

          <h3 class="mb-2 text-sm font-semibold text-[#9aa5b1]">只想看界面(不需要 runtime 或 API key)</h3>
          <pre class="mb-2 overflow-x-auto rounded border border-[#202832] bg-[#0a0e13] p-4 text-sm text-[#e7eaee]"><code><span class="text-[#3aa0ff]">$ </span>martty --demo
<span class="text-[#3aa0ff]">$ </span>martty --demo-skin</code></pre>
          <p class="text-xs text-[#66707c]">`--demo-skin` 使用内置 ember 皮肤展示主题切换。</p>
        </section>

        <!-- UI -->
        <section id="ui" class="border-b border-[#171d25] py-14">
          <h2 class="mb-2 text-2xl font-semibold">UI 简介</h2>
          <p class="mb-8 max-w-2xl text-sm leading-relaxed text-[#9aa5b1]">
            Martty 在终端中完整呈现 agent 工作过程:流式回复、推理、工具调用、subagent、Plan、
            token 用量与持久化会话。以下分别是启动界面、会话恢复与模型选择。
          </p>

          <figure class="mb-8">
            <img src="/ui_start.png" alt="Martty 启动界面" class="w-full rounded border border-[#202832]" loading="lazy" />
            <figcaption class="mt-2 text-xs text-[#66707c]">启动界面:欢迎页展示品牌、版本、模型、workspace 与 session 信息。</figcaption>
          </figure>

          <div class="grid gap-8 md:grid-cols-2">
            <figure>
              <img src="/ui_resume.png" alt="Martty 会话恢复界面" class="w-full rounded border border-[#202832]" loading="lazy" />
              <figcaption class="mt-2 text-xs text-[#66707c]">会话恢复:`/resume` 或 `--session-id` 恢复持久化 JSONL 会话,workspace、模型与权限设置一并还原。</figcaption>
            </figure>
            <figure>
              <img src="/ui_modelsel.png" alt="Martty 模型选择界面" class="w-full rounded border border-[#202832]" loading="lazy" />
              <figcaption class="mt-2 text-xs text-[#66707c]">模型选择:`/model` 直接选择 agent 宣告的模型,输入前缀即可过滤候选。</figcaption>
            </figure>
          </div>

          <div class="mt-10 grid gap-4 sm:grid-cols-3">
            <div class="rounded border border-[#202832] bg-[#0a0e13] p-5">
              <h3 class="mb-1 text-sm font-semibold text-[#3aa0ff]">完整时间线</h3>
              <p class="text-xs leading-relaxed text-[#9aa5b1]">推理、回复、工具参数与结果、插件上下文、subagent 生命周期、token/缓存指标,状态行实时显示阶段、耗时与队列深度。</p>
            </div>
            <div class="rounded border border-[#202832] bg-[#0a0e13] p-5">
              <h3 class="mb-1 text-sm font-semibold text-[#3aa0ff]">多图 prompt</h3>
              <p class="text-xs leading-relaxed text-[#9aa5b1]">可从文件、剪贴板或粘贴暂存最多 8 张图片,`[image n]` chip 内联显示,预览包含名称、尺寸、大小与类型。</p>
            </div>
            <div class="rounded border border-[#202832] bg-[#0a0e13] p-5">
              <h3 class="mb-1 text-sm font-semibold text-[#3aa0ff]">原生 ACP 能力</h3>
              <p class="text-xs leading-relaxed text-[#9aa5b1]">直接读取模型的 model、compositions、permissions、认证方式与可用命令;技能与内置命令共用一个可搜索的斜杠菜单。</p>
            </div>
          </div>
        </section>

        <!-- Usage -->
        <section id="usage" class="py-14">
          <h2 class="mb-2 text-2xl font-semibold">如何使用</h2>
          <p class="mb-6 max-w-2xl text-sm text-[#9aa5b1]">常用按键与命令:</p>
          <div class="overflow-x-auto rounded border border-[#202832]">
            <table class="w-full border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-[#202832] bg-[#0a0e13] text-xs uppercase tracking-wide text-[#66707c]">
                  <th class="px-4 py-3 font-medium">按键 / 命令</th>
                  <th class="px-4 py-3 font-medium">行为</th>
                </tr>
              </thead>
              <tbody class="text-[#e7eaee]">
                <tr class="border-b border-[#171d25]"><td class="px-4 py-3"><code>enter</code></td><td class="px-4 py-3 text-[#9aa5b1]">发送消息;回合运行时排队 follow-up</td></tr>
                <tr class="border-b border-[#171d25]"><td class="px-4 py-3"><code>ctrl+x</code></td><td class="px-4 py-3 text-[#9aa5b1]">立即 steer 当前 agent</td></tr>
                <tr class="border-b border-[#171d25]"><td class="px-4 py-3"><code>esc</code></td><td class="px-4 py-3 text-[#9aa5b1]">中断当前回合并保留草稿</td></tr>
                <tr class="border-b border-[#171d25]"><td class="px-4 py-3"><code>/</code></td><td class="px-4 py-3 text-[#9aa5b1]">打开命令与参数候选菜单</td></tr>
                <tr class="border-b border-[#171d25]"><td class="px-4 py-3"><code>/model</code> · <code>/agent</code></td><td class="px-4 py-3 text-[#9aa5b1]">选择模型和 Agent Preset</td></tr>
                <tr class="border-b border-[#171d25]"><td class="px-4 py-3"><code>/permission</code> · <code>shift+tab</code></td><td class="px-4 py-3 text-[#9aa5b1]">选择或轮换权限模式</td></tr>
                <tr class="border-b border-[#171d25]"><td class="px-4 py-3"><code>/image &lt;path&gt;</code> · <code>/clip</code></td><td class="px-4 py-3 text-[#9aa5b1]">添加本地图片或剪贴板图片</td></tr>
                <tr class="border-b border-[#171d25]"><td class="px-4 py-3"><code>/theme</code> · <code>ctrl+t</code></td><td class="px-4 py-3 text-[#9aa5b1]">选择 Theme Plugin 或切换明暗变体</td></tr>
                <tr class="border-b border-[#171d25]"><td class="px-4 py-3"><code>/ui</code></td><td class="px-4 py-3 text-[#9aa5b1]">切换整套 UI 组合(如 Martty / DeepSeek)</td></tr>
                <tr class="border-b border-[#171d25]"><td class="px-4 py-3"><code>/new</code> · <code>/resume</code></td><td class="px-4 py-3 text-[#9aa5b1]">新建或恢复持久化会话</td></tr>
                <tr class="border-b border-[#171d25]"><td class="px-4 py-3"><code>!cmd</code></td><td class="px-4 py-3 text-[#9aa5b1]">在 workspace 的会话级本地 shell 中执行命令</td></tr>
                <tr><td class="px-4 py-3"><code>/help</code> · <code>/keys</code></td><td class="px-4 py-3 text-[#9aa5b1]">查看命令与完整快捷键列表</td></tr>
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-xs leading-relaxed text-[#66707c]">
            Markdown、代码块与工具输出使用终端原生交互;工具结果默认折叠为最后四行,点击即可展开。
            图片预览、剪贴板路由与 kitty 图片协议按终端能力自动适配。
          </p>
        </section>
      </main>

      <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-[#171d25] py-6 text-xs text-[#4c5560]">
        <span>© {year} Martty · MIT License</span>
        <nav class="flex gap-4">
          <a href="https://www.npmjs.com/package/martty" class="hover:text-[#9aa5b1]">npm</a>
          <a href="https://github.com/openma-ai/Martty" class="hover:text-[#9aa5b1]">GitHub</a>
          <a href="/en" class="hover:text-[#9aa5b1]">English</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
