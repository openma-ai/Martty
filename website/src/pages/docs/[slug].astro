---
import DocsLayout from "../../layouts/DocsLayout.astro";

const VALID_SLUGS = new Set(["plugin-systems", "architecture", "plugins", "migration"]);
const slug = Astro.params.slug ?? "plugin-systems";
if (!VALID_SLUGS.has(slug)) return new Response("Not Found", { status: 404 });
---

<DocsLayout locale="zh" slug={slug} />
