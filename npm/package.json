    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "^0.0.1-rc.5"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek",
    "harness",
    "tui",
    "agent",
    "deepseek-harness",
    "dsh-plugin"
  ]
}
