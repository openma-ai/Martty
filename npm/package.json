{
  "name": "@deepseek-ai-harness/tui",
  "version": "0.1.0",
  "description": "DeepSeek Build (dsh-tui) — grok-build style terminal UI for the deepseek-harness agent runtime; standalone CLI or dsh profile bundle",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-tui": "bin/dsh-tui.js",
    "dsb": "bin/dsh-tui.js"
  },
  "files": [
