{
  "name": "@openma/deepseek-harness-tui",
  "version": "0.2.0",
  "description": "Terminal-native agent UI for DeepSeek Harness; standalone CLI or dsh profile bundle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openma-ai/deepseek-harness-tui.git"
  },
  "homepage": "https://github.com/openma-ai/deepseek-harness-tui#readme",
  "bugs": {
    "url": "https://github.com/openma-ai/deepseek-harness-tui/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test ../scripts/package-native.test.mjs ../scripts/check-release-tag.test.mjs ../scripts/plugin-runner.test.mjs ../scripts/jsonrpc-line-transport.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-tui": "bin/dsh-tui.js",
    "dsb": "bin/dsh-tui.js"
  },
  "files": [
    "bin",
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek",
    "harness",
    "tui",
    "agent",
    "deepseek-harness",
    "dsh-plugin"
  ]
}
